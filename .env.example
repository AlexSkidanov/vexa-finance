# =============================================================================
# Vexa backend: environment
# Copy to .env and fill in. Never commit .env. Validate with: pnpm check-env
# See docs/SETUP.md for step-by-step instructions for every value.
#
# "REQUIRED"  = check-env fails without it.
# "LATER"     = produced by a later phase (deploys); check-env reports it as pending.
# "OPTIONAL"  = only needed for a specific tool (CI, deploy) or a stubbed feature.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development                         # development | test | production
PORT=8787                                    # port the Hono API listens on
LOG_LEVEL=info                               # pino level: trace | debug | info | warn | error
API_BASE_URL=http://localhost:8787           # REQUIRED. Public URL of the API (Railway URL in prod); used in webhook URLs and WebAuthn origin checks
API_KEY_ENCRYPTION_KEY=                      # REQUIRED. 32 bytes hex (openssl rand -hex 32). HMAC pepper for hashing vx_test_/vx_live_ API keys
WEBHOOK_SIGNING_SECRET=                      # REQUIRED. >=32 chars (openssl rand -hex 32). Master secret for HMAC-SHA256 outbound webhook signatures
VIEW_KEY_ENCRYPTION_KEY=                     # REQUIRED. 32 bytes hex (openssl rand -hex 32). Seeds the Ed25519 key that signs audit exports

# WebAuthn / passkeys (relying party). Must match the domain the frontend is served from.
WEBAUTHN_RP_ID=localhost                     # REQUIRED. vexa.finance in prod, localhost for local dev
WEBAUTHN_RP_NAME=Vexa                        # REQUIRED. Display name shown in the passkey prompt
WEBAUTHN_ORIGINS=http://localhost:3000       # REQUIRED. Comma-separated allowed origins, e.g. https://app.vexa.finance

# -----------------------------------------------------------------------------
# Supabase  (dashboard -> Project Settings -> API / Database)
# -----------------------------------------------------------------------------
SUPABASE_URL=                                # REQUIRED. https://<project-ref>.supabase.co  (Settings -> API -> Project URL)
SUPABASE_ANON_KEY=                           # REQUIRED. Settings -> API Keys -> anon/publishable key (public, RLS-bound)
SUPABASE_SERVICE_ROLE_KEY=                   # REQUIRED. Settings -> API Keys -> service_role/secret key (server only, bypasses RLS)
SUPABASE_DB_URL=                             # REQUIRED. Connect button -> Session pooler URI (postgresql://postgres.<ref>:<pw>@...:5432/postgres)
SUPABASE_JWT_SECRET=                         # REQUIRED if your project uses the legacy HS256 JWT secret (Settings -> JWT Keys -> Legacy JWT Secret). Leave blank if the project uses asymmetric signing keys (verified via JWKS)

# -----------------------------------------------------------------------------
# Alchemy  (dashboard.alchemy.com)
# -----------------------------------------------------------------------------
ALCHEMY_SOLANA_RPC_URL=                      # REQUIRED. Apps -> your app -> Solana -> Mainnet HTTPS URL: https://solana-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_WEBHOOK_SIGNING_KEY=                 # REQUIRED. Webhooks (Notify) -> your Address Activity webhook -> Signing Key (whsec_...)
ALCHEMY_WEBHOOK_ID=                          # LATER.    Webhook ID (wh_...) of that webhook; the API adds vault/user token accounts to it
ALCHEMY_NOTIFY_AUTH_TOKEN=                   # LATER.    Webhooks page -> "Auth Token" (top right); needed to add addresses to the webhook via API

# -----------------------------------------------------------------------------
# Solana
# -----------------------------------------------------------------------------
SOLANA_CLUSTER=mainnet-beta                  # REQUIRED. mainnet-beta | devnet  (check-env verifies the RPC's genesis hash matches)
SOLANA_FEE_PAYER_KEYPAIR=                    # REQUIRED. base58 64-byte secret key (or solana-keygen JSON array) of the relayer that pays tx fees + sponsored account rent
SOLANA_ADMIN_KEYPAIR=                        # REQUIRED. base58 64-byte secret key: program upgrade authority + cUSDC mint/CT authority. Keep separate from fee payer
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v   # REQUIRED. Circle USDC on mainnet. Devnet: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
VAULT_PROGRAM_ID=                            # LATER (Phase 1). Program ID printed by `anchor deploy` for programs/vault
CUSDC_MINT=                                  # LATER (Phase 1). Token-2022 mint with ConfidentialTransfer extension, created by the vault init script
VEXA_TOKEN_MINT=                             # Written by pnpm token:create. $VEXA SPL mint (1B supply, mint authority revoked)
TREASURY_OWNER_PUBKEY=                       # REQUIRED for pnpm vault:set-fees. Owner of the treasury USDC account that receives protocol fees
FEE_PAYER_MIN_SOL=0.05                       # check-env minimum. Covers tx fees + rent for ~10 sponsored confidential token accounts
ADMIN_MIN_SOL=0.005                          # check-env minimum. Fees for occasional admin actions (pause, handover, auditor key). Deploy costs are checked by pnpm deploy:vault

# -----------------------------------------------------------------------------
# NEAR  (policy contract + chain signatures)
# -----------------------------------------------------------------------------
NEAR_NETWORK=mainnet                         # REQUIRED. mainnet | testnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com   # REQUIRED. Mainnet public RPC. Testnet: https://test.rpc.fastnear.com
NEAR_DEPLOYER_ACCOUNT_ID=                    # REQUIRED. Named mainnet account, e.g. vexa-deployer.near (see docs/SETUP.md section 5)
NEAR_DEPLOYER_PRIVATE_KEY=                   # REQUIRED. ed25519:<base58> full-access key for the deployer account (~/.near-credentials/mainnet/<account>.json)
NEAR_POLICY_CONTRACT_ID=                     # Agents. Account the policy contract is deployed to (pnpm deploy:policy). Empty: agents disabled
NEAR_MPC_CONTRACT_ID=v1.signer               # REQUIRED. Chain-signatures MPC signer. Testnet: v1.signer-prod.testnet
NEAR_DEPLOYER_MIN_NEAR=0.1                   # check-env minimum. The deployer relays policy calls: ~0.01 NEAR per agent, ~0.001 per agent payment

# -----------------------------------------------------------------------------
# NEAR Intents: 1Click API (stealth route: cUSDC -> USDC -> ZEC -> USDC)
# -----------------------------------------------------------------------------
INTENTS_1CLICK_BASE_URL=https://1click.chaindefuser.com   # REQUIRED
INTENTS_1CLICK_API_KEY=                      # OPTIONAL. X-API-Key from partners.near-intents.org; without it 1Click adds ~0.2% to quotes

# -----------------------------------------------------------------------------
# Stealth transfers (shielded pool hop). Empty STEALTH_ROUTE_SEED or ZCASH_SEED: disabled
# -----------------------------------------------------------------------------
STEALTH_ROUTE_SEED=                          # 32 bytes hex (openssl rand -hex 32). Every route's one-time Solana addresses derive from it
ZCASH_SEED=                                  # 24-word mnemonic of the shielded wallet routes pass through (zingo-cli restores it)
ZCASH_BIRTHDAY=                              # Block height the wallet was created at (speeds up the first sync)
ZCASH_DATA_DIR=/data/zcash                   # Wallet data directory; a persistent volume on Railway
ZCASH_LIGHTWALLETD_URL=https://na.zec.rocks:443   # Light wallet server (zingo-cli syncs through it over the Nym mixnet)
ZINGO_CLI_PATH=zingo-cli                     # The Docker image installs zingo-cli and nym-proxy on PATH
ZINGO_NYM_PROXY=                             # OPTIONAL. Path to nym-proxy if it isn't beside zingo-cli

# -----------------------------------------------------------------------------
# Email  (postmarkapp.com). Sign-in codes in Vexa's own template from a vexa.finance address
# -----------------------------------------------------------------------------
POSTMARK_SERVER_TOKEN=                       # RECOMMENDED. Server API token. Without it, Supabase's built-in sender only reaches project members
SMTP_URL=                                    # OPTIONAL. smtps://user%40vexa.finance:app-password@smtp.fastmail.com:465. Used instead of Postmark when set
EMAIL_FROM=Vexa <verify@vexa.finance>        # OPTIONAL. Must be on a domain verified in Postmark

# -----------------------------------------------------------------------------
# GitHub  (CI only; not used by the running API)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=                                # OPTIONAL. Fine-grained PAT scoped to AlexSkidanov/vexa-finance (Contents, Pull requests, Actions)

# -----------------------------------------------------------------------------
# Railway  (deploy only)
# -----------------------------------------------------------------------------
RAILWAY_TOKEN=                               # OPTIONAL. Railway project -> Settings -> Tokens -> project token (for `railway up` in CI)

# -----------------------------------------------------------------------------
# Stubs: interfaces only for now, leave empty
# -----------------------------------------------------------------------------
CARD_ISSUER_API_KEY=                         # OPTIONAL. Lithic / Rain (future)
KYC_PROVIDER_API_KEY=                        # OPTIONAL. Persona / Sumsub (future)
